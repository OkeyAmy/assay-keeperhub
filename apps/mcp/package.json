{
  "name": "@assay/mcp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "MCP server exposing Assay verification to any agent.",
  "license": "Apache-2.0",
  "bin": { "assay-mcp": "./src/index.ts" },
  "scripts": {
