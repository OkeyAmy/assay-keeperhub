    "@assay/core": "workspace:*",
    "@assay/keeperhub": "workspace:*",
    "@assay/observer": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "viem": "^2.52.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
