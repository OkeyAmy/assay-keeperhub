# ---------------------------------------------------------------------------
# Assay — copy to .env and fill in. Nothing here is baked into the code.
# Defaults target testnets; no value below moves real funds unless you change
# CHAIN_ID to a mainnet id yourself.
# ---------------------------------------------------------------------------

# --- KeeperHub -------------------------------------------------------------
# Org API key from app.keeperhub.com. Required to execute anything.
KH_API_KEY=
KH_API_BASE=https://app.keeperhub.com
KH_MCP_URL=https://app.keeperhub.com/mcp
# Slug this deployment publishes the verifier workflow under.
KH_MARKETPLACE_SLUG=assay-verify

# --- Chains ----------------------------------------------------------------
# Chain the agent executes its value-moving action on.
#   11155111 = Ethereum Sepolia (the testnet in KeeperHub's quickstart)
#   8453     = Base mainnet
CHAIN_ID=11155111

# Chain x402 / MPP payments settle on. KeeperHub's agentic wallet only signs on
# Base (8453), Tempo mainnet (4217) and Tempo testnet (42431) — Base Sepolia is
# NOT supported, which is why the testnet payment leg uses Tempo.
PAYMENT_CHAIN_ID=42431

# --- Independent read layer ------------------------------------------------
# Comma-separated RPC endpoints. These must NOT be KeeperHub infrastructure:
# a verifier that reads through the executor agrees with it by construction.
# Use two different providers so quorum means something.
RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co,https://1rpc.io/sepolia,https://sepolia.drpc.org
OBSERVER_QUORUM=2
OBSERVER_TIMEOUT_MS=10000
# Optional Blockscout REST base for the target chain, e.g.
# https://eth-sepolia.blockscout.com
BLOCKSCOUT_URL=

# --- Contracts (fill in after deploying) -----------------------------------
INTENT_REGISTRY=
RECEIPT_REGISTRY=

# --- Identity --------------------------------------------------------------
# The KeeperHub org wallet that executes and is credited as the verifier in
# ReceiptRegistry. Read it from app.keeperhub.com -> Organization Wallet.
ORG_WALLET_ADDRESS=

# --- Strategy --------------------------------------------------------------
# The value-moving action the agent commits to and then verifies. It must have
# a falsifiable effect: PolicyGuard rejects an intent with no observable result.
# USDC on Ethereum Sepolia (6 decimals) — faucet: https://faucet.circle.com
STRATEGY_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Where the demo transfer goes. Any address you control.
STRATEGY_RECIPIENT=
# Base units. 1000000 = 1 USDC at 6dp. Must stay under MAX_VALUE_PER_TX.
STRATEGY_AMOUNT=1000000
# The agent will not act if the org wallet holds less than this.
STRATEGY_MIN_BALANCE=1000000
# Upper bound declared in the intent; a run burning more than this is DIVERGENT.
# Measured: KeeperHub sponsored execution adds ~80k of 7702/smart-account
# wrapper overhead on top of the raw transfer (21k simulated -> 102k actual on
# a bare ETH send), so a bound sized for a plain ERC-20 transfer is too tight.
STRATEGY_MAX_GAS=250000

# --- Agent guards ----------------------------------------------------------
# Protects the KeeperHub execution quota (free tier is 5,000/month).
MAX_EXECUTIONS_PER_DAY=200
# Largest single transfer, in the token's base units (5000000 = 5 USDC at 6dp).
MAX_VALUE_PER_TX=5000000
INTENT_TTL_SECONDS=900
MAX_ATTEMPTS=3
TICK_INTERVAL_MS=60000
# Set to true to stop the runner without redeploying.
KILL_SWITCH=false

# --- Contract deployment (Foundry only; never used by the agent) -----------
# The agent NEVER signs with a private key — every agent transaction goes
# through KeeperHub. This is only for the one-time registry deployment.
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
